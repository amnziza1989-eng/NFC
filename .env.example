# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (for Docker Compose, use service name 'db')
DATABASE_URL=postgresql+asyncpg://nfc_user:nfc_password@db:5432/nfc_db

# Public-facing base URL (used for NFC/QR URL generation)
PUBLIC_BASE_URL=https://tap.example.com

# Logging
LOG_LEVEL=INFO

# PostgreSQL container settings
POSTGRES_USER=nfc_user
POSTGRES_PASSWORD=nfc_password
POSTGRES_DB=nfc_db
