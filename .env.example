# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Docker host port (maps to container port 8000)
HOST_PORT=8300

# Database (for Docker Compose, use service name 'db')
DATABASE_URL=postgresql+asyncpg://nfc_user:nfc_password@db:5432/nfc_db

# Public-facing base URL (used for NFC/QR URL generation)
PUBLIC_BASE_URL=https://tap.example.com

# Security (Required for /api/v1 management endpoints)
API_KEY=your-secure-api-key-here

# Redis (Rate Limiting)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# PostgreSQL container settings
POSTGRES_USER=nfc_user
POSTGRES_PASSWORD=nfc_password
POSTGRES_DB=nfc_db

# Shipping & Tracking
POST_TRACKING_BASE_URL=https://tracking.post.ir/?traking_code=

# SMS Gateway (mock for local testing, kavenegar/ghasedak/etc for production)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE_ID=
